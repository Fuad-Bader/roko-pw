{
  "name": "roko-pw",
  "version": "0.2.0",
  "private": true,
  "description": "RokoPW monorepo: landing site, vault web app, admin console and shared packages",
  "workspaces": [
    "apps/landing",
    "apps/vault",
    "apps/admin",
    "packages/*"
  ],
  "scripts": {
    "dev:landing": "npm run dev -w @roko/landing",
    "dev:vault": "npm run dev -w @roko/vault",
    "dev:admin": "npm run dev -w @roko/admin",
    "dev:server": "npm run dev --prefix apps/server",
    "build": "npm run build -w @roko/landing -w @roko/vault -w @roko/admin",
    "build:landing": "npm run build -w @roko/landing",
    "build:vault": "npm run build -w @roko/vault",
    "build:admin": "npm run build -w @roko/admin",
    "typecheck": "npm run typecheck -w @roko/landing -w @roko/vault -w @roko/admin",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "typescript": "^5"
  }
}
