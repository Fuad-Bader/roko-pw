{
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "ESNext"
    ],
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@roko/vault-core/*": [
        "../../packages/vault-core/src/*"
      ]
    }
  }
}
