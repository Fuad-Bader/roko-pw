# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root, workspaces, desktop, server)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (apps/landing)
.next/
/apps/landing/out/

# production builds
/build
/apps/vault/dist/
/apps/admin/dist/
/server/dist/

# desktop app build output
/apps/desktop/dist

# packaged desktop binaries served by the landing page — generated by
# `npm --prefix apps/desktop run dist:win`, not committed (too large for git).
/apps/landing/public/downloads/*
!/apps/landing/public/downloads/README.md

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
memory/lilacrypt-report.md
/Documentation