# RokoPW org server configuration. Copy to .env and fill in.
# Keep this file plain ASCII with truly empty blank lines: Node's --env-file
# silently drops every variable after a "blank" line that contains a space.

PORT=4567
# Address people use to reach this server (used in emails)
PUBLIC_URL=https://vault.example.com
# Where the SQLite database lives (the Docker image uses /data)
DATA_DIR=./data

# ── Organization ─────────────────────────────────────────────────────────────
# A new server is set up in the admin console (/admin) with a one-time setup
# code printed to the server log. Set SETUP_TOKEN to choose the code yourself
# (e.g. from a secrets manager) instead.
SETUP_TOKEN=
# Emails that are always org admins (comma-separated). They can also claim a
# new server by signing in with an emailed code, without the setup code.
ADMIN_EMAILS=
# Who can create an account is chosen in the admin console (invite-only by
# default). Set to true or false here to force it and lock that setting.
ALLOW_SIGNUPS=
# Email members when someone saves a shared vault (at most once an hour per vault).
NOTIFY_ON_WRITE=false

# ── Email (sign-in codes are always sent by email) ───────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RokoPW <noreply@example.com>
# Development only: print emails (including sign-in codes) to the console
# instead of sending them. Never enable on a real server.
MAIL_LOG=false

# ── Lifetimes ────────────────────────────────────────────────────────────────
OTP_TTL_MINUTES=15
SESSION_TTL_DAYS=30
