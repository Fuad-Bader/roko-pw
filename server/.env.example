# RokoPW org server configuration. Copy to .env and fill in.
# Keep this file plain ASCII with truly empty blank lines: Node's --env-file
# silently drops every variable after a "blank" line that contains a space.

PORT=4567
# Address people use to reach this server (used in emails)
PUBLIC_URL=https://vault.example.com
# Where the SQLite database lives (the Docker image uses /data)
DATA_DIR=./data

# ── Organization ─────────────────────────────────────────────────────────────
# Emails that are always org admins (comma-separated). If empty, the first
# account created on the server becomes the admin.
ADMIN_EMAILS=
# Invite-only by default: admins add people in the admin console.
# Set to true to let anyone with the server address create an account.
ALLOW_SIGNUPS=false
# Email members when someone saves a shared vault (at most once an hour per vault).
NOTIFY_ON_WRITE=false

# ── Email (sign-in codes are always sent by email) ───────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RokoPW <noreply@example.com>
# Development only: print emails (including sign-in codes) to the console
# instead of sending them. Never enable on a real server.
MAIL_LOG=false

# ── Lifetimes ────────────────────────────────────────────────────────────────
OTP_TTL_MINUTES=15
SESSION_TTL_DAYS=30
