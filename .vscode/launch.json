{
  "version": "0.2.0",
  "configurations": [
    // ── Landing site (apps/landing, Next.js) ──────────────────────────────────
    {
      "name": "Landing: dev server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/next",
      "args": ["dev", "-p", "3000"],
      "cwd": "${workspaceFolder}/apps/landing",
      "env": { "NODE_ENV": "development" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Landing: attach to running dev server",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "urlFilter": "http://localhost:3000/*",
      "webRoot": "${workspaceFolder}/apps/landing"
    },

    // ── Vault and admin apps (Vite) ────────────────────────────────────────────
    {
      "name": "Vault app: dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:vault",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Admin console: dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:admin",
      "cwd": "${workspaceFolder}"
    },

    // ── Hono server ────────────────────────────────────────────────────────────
    {
      "name": "Server: dev (tsx watch)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "tsx/esm",
        "--inspect"
      ],
      "program": "${workspaceFolder}/apps/server/src/index.ts",
      "cwd": "${workspaceFolder}/apps/server",
      "envFile": "${workspaceFolder}/apps/server/.env.example",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "outFiles": ["${workspaceFolder}/apps/server/dist/**/*.js"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/apps/server/**",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "Server: built (node dist/index.js)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/server/dist/index.js",
      "cwd": "${workspaceFolder}/apps/server",
      "envFile": "${workspaceFolder}/apps/server/.env.example",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },

    // ── Electron desktop ───────────────────────────────────────────────────────
    {
      "name": "Electron: main process",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/apps/desktop/node_modules/.bin/electron",
      "runtimeArgs": [
        "--inspect=9229",
        "${workspaceFolder}/apps/desktop/out/main/index.js"
      ],
      "cwd": "${workspaceFolder}/apps/desktop",
      "env": { "ELECTRON_RUN_AS_NODE": "" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "outFiles": ["${workspaceFolder}/apps/desktop/out/**/*.js"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/apps/desktop/**",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "Electron: renderer (Chrome DevTools)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "urlFilter": "http://localhost:5173/*",
      "webRoot": "${workspaceFolder}/apps/desktop/src/renderer/src",
      "sourceMapPathOverrides": {
        "/@fs/*": "*",
        "/src/*": "${workspaceFolder}/apps/desktop/src/renderer/src/*"
      }
    }
  ],

  "compounds": [
    {
      "name": "Full stack: vault + admin + server",
      "configurations": ["Vault app: dev server", "Admin console: dev server", "Server: dev (tsx watch)"],
      "stopAll": true
    },
    {
      "name": "Electron: main + renderer",
      "configurations": ["Electron: main process", "Electron: renderer (Chrome DevTools)"],
      "stopAll": true,
      "presentation": { "hidden": false, "group": "Desktop" }
    }
  ]
}
