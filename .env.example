# docker-compose.yml settings. Copy to .env next to docker-compose.yml.
# Server configuration (SMTP, admins, ...) lives in apps/server/.env.

# Public addresses, baked into the static apps at build time.
# Where the landing site's "Open vault" / "Sign in" buttons go.
VAULT_URL=https://app.example.com
# Prefilled org server address on the vault's sign-in screen.
ORG_SERVER_URL=https://vault.example.com

# Host ports.
LANDING_PORT=3000
VAULT_PORT=3001
SERVER_PORT=4567
